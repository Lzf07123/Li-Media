# 单容器镜像:前端 trunk 构建产物内嵌进 Go 二进制,一个进程同时
# 服务静态资源与 /api。
#
# 构建上下文为仓库根:
#   docker build -f Dockerfile.single -t limedia .
#
# 分层策略:rust 依赖与 Go 模块各自缓存,源码改动只失效最后一层;
# Cargo registry/target 与 Go build cache 使用 BuildKit 缓存挂载,
# 跨多次构建复用编译产物(需要 BuildKit,Compose v2 默认启用)。
# 不写 # syntax 指令:避免额外从 Docker Hub 拉取 frontend 镜像,
# 内置 BuildKit 已支持 RUN --mount=type=cache。
# 基础镜像统一拼 IMAGE_REGISTRY 前缀(留空则回退 Docker Hub);
# RUST_IMAGE / GO_IMAGE / RUN_IMAGE 只写裸仓库名与标签。
ARG IMAGE_REGISTRY=docker.m.daocloud.io/library/
ARG RUST_IMAGE=rust:1-slim
ARG GO_IMAGE=golang:1.26-alpine
ARG RUN_IMAGE=alpine:3.20

# ---- 1. 前端 ----
FROM ${IMAGE_REGISTRY}${RUST_IMAGE} AS web
ARG CARGO_NET_GIT_FETCH_WITH_CLI=true
# rustup 组件(dist/rust-std)与自更新走镜像源;官方源可改为
# https://static.rust-lang.org / https://update.rustup.rs
ARG RUSTUP_DIST_SERVER=https://mirrors.ustc.edu.cn/rust-static
ARG RUSTUP_UPDATE_ROOT=https://mirrors.ustc.edu.cn/rust-static/rustup
# crates.io 稀疏索引镜像;留空则使用官方 crates.io。
ARG CARGO_REGISTRY_MIRROR=sparse+https://mirrors.ustc.edu.cn/crates.io-index/
# 构建并发上限:默认 4,避免 Rust 依赖编译打满整机;CI 可调大(如 8/16),
# 低配机可调到 2。CARGO_BUILD_JOBS 同时作用于工具安装与 trunk 的前端构建。
# dev profile 的 codegen-units 默认 256:即便 jobs=4,每个 rustc 仍会
# 并行大量代码生成单元,把负载顶到几十。压到 1 后 BUILD_JOBS 才是真正的
# 并发上限;release 前端构建沿用 Cargo.toml 的 codegen-units=1。
ARG BUILD_JOBS=4
ENV CARGO_NET_GIT_FETCH_WITH_CLI=$CARGO_NET_GIT_FETCH_WITH_CLI \
    RUSTUP_DIST_SERVER=$RUSTUP_DIST_SERVER \
    RUSTUP_UPDATE_ROOT=$RUSTUP_UPDATE_ROOT \
    CARGO_BUILD_JOBS=$BUILD_JOBS \
    CARGO_PROFILE_DEV_CODEGEN_UNITS=1
RUN if [ -n "$CARGO_REGISTRY_MIRROR" ]; then \
        mkdir -p "$CARGO_HOME" \
        && printf '[source.crates-io]\nreplace-with = "mirror"\n\n[source.mirror]\nregistry = "%s"\n\n[net]\nretry = 5\n' "$CARGO_REGISTRY_MIRROR" > "$CARGO_HOME/config.toml"; \
    fi
WORKDIR /src
# wasm32 标准库单独成层:不依赖任何源码,依赖版本变化也不会重复下载。
RUN --mount=type=cache,target=/usr/local/rustup/downloads,sharing=locked \
    rustup target add wasm32-unknown-unknown
# trunk 只用于 build:关闭 update_check/rustls;dev profile 冷编译更快,
# 运行期只慢约 1s(实测)。独立成层,不随 Cargo.lock 变化重装。
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/tmp/trunk-target \
    CARGO_TARGET_DIR=/tmp/trunk-target cargo install trunk --locked --version 0.21.14 \
        --no-default-features --profile dev
COPY frontend/Cargo.toml frontend/Cargo.lock ./
# wasm-bindgen CLI 从 crates.io 安装并预置到 trunk 工具缓存,避免构建期
# 从 GitHub 下载二进制——该链路在国内网络下经常断流。dev profile 冷编译
# 27s(release 139s),实测 trunk 构建仅慢约 1s。
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/tmp/trunk-target \
    WB_VERSION=$(awk '/^name = "wasm-bindgen"$/{getline; gsub(/[^0-9.]/, ""); print; exit}' Cargo.lock) \
    && test -n "$WB_VERSION" \
    && CARGO_TARGET_DIR=/tmp/trunk-target cargo install wasm-bindgen-cli --version "$WB_VERSION" --profile dev \
    && mkdir -p "/root/.cache/trunk/wasm-bindgen-$WB_VERSION" \
    && cp /usr/local/cargo/bin/wasm-bindgen "/root/.cache/trunk/wasm-bindgen-$WB_VERSION/wasm-bindgen"
COPY frontend/ ./
# Cargo target 缓存跨构建复用:源码改动只重编应用 crate,不再重编全部依赖。
RUN --mount=type=cache,target=/src/target,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    trunk build --release

# ---- 2. 后端(嵌入前端产物) ----
FROM ${IMAGE_REGISTRY}${GO_IMAGE} AS api
ARG GOPROXY=https://goproxy.cn,direct
# 与 Rust 阶段同口径的并发上限,避免多包并行编译叠加负载。
ARG BUILD_JOBS=4
ENV GOPROXY=$GOPROXY CGO_ENABLED=0
WORKDIR /app
COPY backend/go.mod backend/go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go mod download
COPY backend/ ./
# go:embed 需要编译时文件在模块内:用构建产物覆盖占位 dist。
RUN rm -rf internal/web/dist && mkdir -p internal/web/dist
COPY --from=web /src/dist/ ./internal/web/dist/
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go build -p "$BUILD_JOBS" -trimpath -ldflags="-s -w" -o /out/limedia ./cmd/server

# ---- 3. 运行时 ----
FROM ${IMAGE_REGISTRY}${RUN_IMAGE} AS runtime
ARG APT_MIRROR=""
# apk 索引与包缓存挂载:镜像层变化时无需重新下载 ffmpeg 依赖树。
RUN --mount=type=cache,target=/var/cache/apk,sharing=locked \
    if [ -n "$APT_MIRROR" ]; then sed -i "s|https://dl-cdn.alpinelinux.org|${APT_MIRROR}|g" /etc/apk/repositories; fi \
    && apk add ffmpeg ca-certificates tzdata \
    && addgroup -S limedia && adduser -S -G limedia limedia \
    && mkdir -p /app/data && chown -R limedia:limedia /app
WORKDIR /app
COPY --from=api /out/limedia /usr/local/bin/limedia
USER limedia
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8000/api/v1/healthz || exit 1
CMD ["limedia"]
