# ---------------------------------------------------------------------------
# PostgreSQL
# 生产部署必须替换默认账号与密码；数据保存在 Compose 卷 postgres_data。
# ---------------------------------------------------------------------------
POSTGRES_USER=media
POSTGRES_PASSWORD=change-me
POSTGRES_DB=media
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# 服务连接
# Compose 会忽略 DATABASE_URL，只用上面的 POSTGRES_* 生成连接串；
# 本机裸跑时可设置 postgresql+psycopg://...@127.0.0.1:5432/...。
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# 同域部署默认只需要 http://localhost:8080；5173 仅用于本地 Vite 开发服务器。
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# 服务端拼接百度 OAuth 回调地址时的基准 URL，应与浏览器可访问的唯一入口一致。
PUBLIC_BASE_URL=http://127.0.0.1:8080

# 唯一宿主入口端口；backend / db / redis 不映射宿主端口。
HTTP_PORT=8080

# ---------------------------------------------------------------------------
# 构建与依赖加速
# IMAGE_REGISTRY 是官方镜像前缀；改为 library/ 可直连 Docker Hub。
# 软件源只影响镜像构建期；安装私有凭证或鉴权源仍只写入本机 .env。
# npm 先探测中科大源；不可达时自动使用 NPM_FALLBACK_REGISTRY。
# ---------------------------------------------------------------------------
IMAGE_REGISTRY=docker.mirrors.ustc.edu.cn/library/
APT_MIRROR=http://mirrors.ustc.edu.cn
PIP_INDEX_URL=https://mirrors.ustc.edu.cn/pypi/simple
NPM_CONFIG_REGISTRY=https://npmreg.mirrors.ustc.edu.cn/
NPM_FALLBACK_REGISTRY=https://registry.npmmirror.com/

# ---------------------------------------------------------------------------
# 前端
# 这是 Vite 构建期变量。同域部署保持 /api/v1；只有跨源开发/部署时才改完整 URL。
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=/api/v1

# ---------------------------------------------------------------------------
# 管理后台与会话
# ADMIN_TOKEN 必须使用强随机值；生产 HTTPS 下建议设置 ADMIN_COOKIE_SECURE=true。
# ---------------------------------------------------------------------------
ADMIN_TOKEN=change-me
ADMIN_SESSION_TTL_MINUTES=120
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# 媒体派生与缓存
# MEDIA_ROOT 是服务端派生图和临时文件根目录；backend_data 卷在容器内挂到 /app/data。
# NGINX_CACHE_ROOT 供后台清理读取；Compose 内固定为 /app/data/nginx_cache，
# 并与 Nginx 的 /var/cache/nginx/limedia 共享同名卷 nginx_cache。
# 修改派生尺寸、质量或裁剪规则后必须更新 MEDIA_DERIVATIVE_VERSION，使旧缓存失效。
# ---------------------------------------------------------------------------
MEDIA_ROOT=./data/media
NGINX_CACHE_ROOT=./data/nginx_cache
MEDIA_DERIVATIVE_VERSION=20260906-ratio-v1

# 服务端视频只提取一帧。该值只允许很小的偏移，避免退化为逐帧扫描。
VIDEO_FRAME_OFFSET_SECONDS=0.0

# 远程首帧按需读取时最多写入的源数据量、临时目录总配额和并发临时文件数。
REMOTE_THUMBNAIL_SOURCE_MAX_BYTES=16777216
# MOV/MP4 的 moov atom 可能在文件尾部；视频首帧需要更大的临时源，但仍会在用后删除。
REMOTE_THUMBNAIL_VIDEO_SOURCE_MAX_BYTES=1073741824
REMOTE_THUMBNAIL_DISK_QUOTA_BYTES=4294967296
REMOTE_THUMBNAIL_MAX_TEMP_FILES=2

# 进程内任务边界。单副本阶段扫描固定为 1；多副本部署前必须先迁移到
# Redis 分布式锁或专用任务队列，不能直接提高这些进程内上限。
SCAN_CONCURRENCY_LIMIT=1
SCAN_QUEUE_LIMIT=1
SCAN_WAIT_TIMEOUT_SECONDS=0.0
DIRECT_PROBE_CONCURRENCY_LIMIT=4
DIRECT_PROBE_QUEUE_LIMIT=16
DIRECT_PROBE_WAIT_TIMEOUT_SECONDS=3.0
DERIVATIVE_CONCURRENCY_LIMIT=1
DERIVATIVE_QUEUE_LIMIT=32
DERIVATIVE_WAIT_TIMEOUT_SECONDS=15.0
STREAM_GLOBAL_CONCURRENCY_LIMIT=16
STREAM_USER_CONCURRENCY_LIMIT=1
STREAM_QUEUE_LIMIT=32
STREAM_WAIT_TIMEOUT_SECONDS=1.0

# 线程池和数据库连接池要与上述任务上限匹配，避免 256m backend cgroup 被放大。
TASK_THREAD_POOL_SIZE=24
BACKEND_MEMORY_LIMIT_BYTES=268435456
DATABASE_POOL_SIZE=8
DATABASE_POOL_MAX_OVERFLOW=8
DATABASE_POOL_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# 百度网盘
# 优先使用 OAuth 自动刷新；BAIDU_ACCESS_TOKEN 只作为紧急本地调试手段。
# Client ID / Secret 与刷新凭证只保存在服务端，不能进入前端或日志。
# 回调地址必须与百度开放平台配置完全一致，并指向唯一 Nginx 入口。
# ---------------------------------------------------------------------------
BAIDU_ACCESS_TOKEN=
BAIDU_OAUTH_CLIENT_ID=
BAIDU_OAUTH_CLIENT_SECRET=
BAIDU_OAUTH_REDIRECT_URI=http://127.0.0.1:8080/admin/baidu/callback
BAIDU_OAUTH_SCOPE=basic,netdisk

# 服务端保存的 OAuth 刷新凭证文件；路径应位于受保护的数据卷，不要提交到仓库。
BAIDU_CREDENTIALS_PATH=./data/config/baidu_token.json

# 只扫描该网盘目录；不会下载或持久化媒体本体。
BAIDU_SYNC_DIR=/apps/Li&Media

# 递归扫描：每页最多 1000 条，目录深度和总条目上限用于保护 API 配额。
BAIDU_SYNC_PAGE_SIZE=1000
BAIDU_SCAN_MAX_DEPTH=8
BAIDU_SCAN_MAX_ITEMS=5000

# 扫描限速与失败退避：降低对百度网盘 API 的请求压力。
BAIDU_REQUEST_INTERVAL_SECONDS=0.2
BAIDU_RETRY_ATTEMPTS=3
BAIDU_RETRY_BASE_DELAY=0.5
BAIDU_RETRY_MAX_DELAY=8

# 百度短时直链的服务端缓存 TTL；前端仍按接口返回的到期时间处理。
BAIDU_DOWNLOAD_URL_TTL_SECONDS=300

# 远程派生前的百度原图/视频帧尺寸请求参数；本地会另生成等比 WebP。
BAIDU_THUMBNAIL_SIZE=c1600_u1600
